file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(READ "${SCENE}" scene)
string(JSON scene SET "${scene}" camera resolution "[32,32]")
string(JSON scene SET "${scene}" renderer spp 4)
string(JSON scene SET "${scene}" renderer spp_step 4)
string(JSON scene SET "${scene}" media 0 first_hit statistics "{\"enabled\":true,\"output_prefix\":\"first-hit-stats\"}")
file(WRITE "${OUTPUT_DIR}/scene.json" "${scene}")
execute_process(COMMAND "${RENDERER}" -t 2 -d "${OUTPUT_DIR}" "${OUTPUT_DIR}/scene.json"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 240)
file(WRITE "${OUTPUT_DIR}/render.log" "${output}\n${errors}")
if (NOT "${result}" STREQUAL "0" OR NOT "${output}" MATCHES "Completed 4/4 spp" OR
    "${output}\n${errors}" MATCHES "Caught an internal error|unrecoverable error|Unable to load|not implemented|nonfinite|terminate called")
    message(FATAL_ERROR "first-hit GPIS render failed (${result}):\n${output}\n${errors}")
endif()
execute_process(COMMAND "${CHECKER}" image "${OUTPUT_DIR}/first-hit-gpis.exr"
    RESULT_VARIABLE result OUTPUT_VARIABLE stats ERROR_VARIABLE errors)
file(WRITE "${OUTPUT_DIR}/validation.log" "${stats}\n${errors}")
if (NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "first-hit image validation failed:\n${stats}\n${errors}")
endif()
message(STATUS "${stats}")
file(READ "${OUTPUT_DIR}/first-hit-stats-summary.json" summary)
string(JSON flights GET "${summary}" counts flights)
string(JSON completed GET "${summary}" counts completed)
string(JSON failed GET "${summary}" counts failed)
string(JSON no_extra GET "${summary}" counts without_extra_nodes)
string(JSON extra GET "${summary}" counts with_extra_nodes)
string(JSON csv_failed GET "${summary}" csv_write_failed)
string(JSON qmc_calls GET "${summary}" sum_per_flight_statistics qmc_calls)
string(JSON qmc_preparations GET "${summary}" sum_per_flight_statistics qmc_preparations)
string(JSON qmc_reused GET "${summary}" sum_per_flight_statistics qmc_reused_points)
string(JSON precheck_calls GET "${summary}" sum_per_flight_statistics precheck_calls)
string(JSON precheck_survived GET "${summary}" sum_per_flight_statistics precheck_survived)
string(JSON precheck_hit GET "${summary}" sum_per_flight_statistics precheck_hit)
string(JSON precheck_marginal_hits GET "${summary}" sum_per_flight_statistics precheck_marginal_hits)
string(JSON precheck_extra GET "${summary}" sum_per_flight_statistics precheck_with_extra_nodes)
string(JSON prefix_queries GET "${summary}" sum_per_flight_statistics prefix_queries)
string(JSON orthant_calls GET "${summary}" sum_per_flight_statistics orthant_calls)
file(STRINGS "${OUTPUT_DIR}/first-hit-stats-rays.csv" csv_lines)
list(LENGTH csv_lines csv_count)
math(EXPR expected_csv_count "${flights}+1")
math(EXPR classified "${no_extra}+${extra}")
if (csv_failed OR NOT failed EQUAL 0 OR NOT completed EQUAL flights OR
    NOT classified EQUAL flights OR NOT csv_count EQUAL expected_csv_count OR
    no_extra LESS 1 OR extra LESS 1)
    message(FATAL_ERROR "first-hit statistics counts/CSV mismatch or missing ray classifications")
endif()
if (qmc_reused LESS 1 OR qmc_preparations LESS 1 OR
    NOT qmc_preparations LESS qmc_calls)
    message(FATAL_ERROR "first-hit render did not reuse QMC points and preparation across budget increases")
endif()
math(EXPR precheck_decisions "${precheck_survived}+${precheck_hit}")
math(EXPR accounted_queries "${orthant_calls}+${precheck_decisions}")
if (precheck_survived LESS 1 OR precheck_hit LESS 1 OR
    precheck_decisions GREATER precheck_calls OR
    precheck_marginal_hits GREATER precheck_hit OR
    precheck_extra GREATER precheck_decisions OR
    accounted_queries LESS prefix_queries)
    message(FATAL_ERROR "first-hit render did not exercise conservative precheck decisions or counters are inconsistent")
endif()
