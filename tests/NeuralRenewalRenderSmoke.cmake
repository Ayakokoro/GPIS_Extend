file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(TO_CMAKE_PATH "${MACROFACET_DIR}" MACROFACET_DIR)
file(READ "${SCENE}" scene_template)
string(CONFIGURE "${scene_template}" scene @ONLY)
string(JSON scene SET "${scene}" camera resolution "[16,16]")
string(JSON scene SET "${scene}" media 0 material force_unit_fresnel true)
string(JSON scene SET "${scene}" primitives 0 bsdf albedo 1)
string(JSON scene SET "${scene}" primitives 1 emission 1)
string(JSON scene SET "${scene}" integrator enable_light_sampling true)
string(JSON scene SET "${scene}" integrator enable_volume_light_sampling true)
set(spp 64)
if (MODE STREQUAL "furnace_no_nee")
    set(spp 8)
    string(JSON scene SET "${scene}" integrator enable_light_sampling false)
    string(JSON scene SET "${scene}" integrator enable_volume_light_sampling false)
elseif (MODE STREQUAL "furnace_wavefront")
    string(JSON scene SET "${scene}" integrator wavefront_gpis true)
endif()
file(WRITE "${OUTPUT_DIR}/scene.json" "${scene}")
execute_process(COMMAND "${RENDERER}" -t 4 -s 17429 --spp "${spp}" -d "${OUTPUT_DIR}" "${OUTPUT_DIR}/scene.json"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 180)
file(WRITE "${OUTPUT_DIR}/render.log" "${output}\n${errors}")
if (NOT "${result}" STREQUAL "0" OR NOT "${output}" MATCHES "Completed ${spp}/${spp} spp" OR
    "${output}\n${errors}" MATCHES "Caught an internal error|unrecoverable error|Unable to load|not implemented|Wrong normal direction|nonfinite|terminate called")
    message(FATAL_ERROR "neural renewal render failed (${result}):\n${output}\n${errors}")
endif()
execute_process(COMMAND "${CHECKER}" --furnace "${OUTPUT_DIR}/neural-bunny.exr"
    RESULT_VARIABLE result OUTPUT_VARIABLE stats ERROR_VARIABLE errors)
file(WRITE "${OUTPUT_DIR}/validation.log" "${stats}\n${errors}")
if (NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "neural renewal image validation failed:\n${stats}\n${errors}")
endif()
message(STATUS "${stats}")
