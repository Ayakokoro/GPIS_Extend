file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(READ "${SCENE}" scene)
if (MODE MATCHES "^gamma_")
    string(REGEX REPLACE "^gamma_" "" MODE "${MODE}")
    string(JSON scene SET "${scene}" media 0 density_multiplier "{\"type\":\"gamma_renewal\",\"alpha\":2}")
    # Ordinary surface reflection in the SAME medium starts an external flight;
    # the forward sheet only splits tracking and must retain the current scale.
    string(JSON scene SET "${scene}" bsdfs 1 "{\"name\":\"white\",\"type\":\"lambert\",\"albedo\":1}")
    string(JSON scene SET "${scene}" primitives 2 "{\"type\":\"sphere\",\"bsdf\":\"white\",\"int_medium\":\"ellipsoids\",\"ext_medium\":\"ellipsoids\",\"transform\":{\"scale\":0.65}}")
    string(JSON scene SET "${scene}" primitives 3 "{\"type\":\"quad\",\"bsdf\":\"boundary\",\"int_medium\":\"ellipsoids\",\"ext_medium\":\"ellipsoids\",\"transform\":{\"position\":[0,-0.5,0],\"scale\":0.6,\"rotation\":[90,0,0]}}")
endif()
if (MODE STREQUAL "no_nee")
    string(JSON scene SET "${scene}" integrator enable_light_sampling false)
    string(JSON scene SET "${scene}" integrator enable_volume_light_sampling false)
elseif (MODE STREQUAL "wavefront")
    string(JSON scene SET "${scene}" integrator wavefront_gpis true)
elseif (MODE STREQUAL "surface_only")
    string(JSON scene SET "${scene}" integrator enable_volume_light_sampling false)
elseif (MODE STREQUAL "volume_only")
    string(JSON scene SET "${scene}" integrator enable_light_sampling false)
endif()
file(WRITE "${OUTPUT_DIR}/scene.json" "${scene}")
execute_process(COMMAND "${RENDERER}" -t 2 -d "${OUTPUT_DIR}" "${OUTPUT_DIR}/scene.json"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 180)
file(WRITE "${OUTPUT_DIR}/render.log" "${output}\n${errors}")
if (NOT "${result}" STREQUAL "0" OR NOT "${output}" MATCHES "Completed 128/128 spp" OR
    "${output}\n${errors}" MATCHES "Caught an internal error|unrecoverable error|Unable to load|not implemented|nonfinite|terminate called")
    message(FATAL_ERROR "local ellipsoid render failed (${result}):\n${output}\n${errors}")
endif()
execute_process(COMMAND "${CHECKER}" image "${OUTPUT_DIR}/ellipsoid.exr"
    RESULT_VARIABLE result OUTPUT_VARIABLE stats ERROR_VARIABLE errors)
file(WRITE "${OUTPUT_DIR}/validation.log" "${stats}\n${errors}")
if (NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "ellipsoid image validation failed:\n${stats}\n${errors}")
endif()
message(STATUS "${stats}")
