{
  "media": [
    {
      "name": "gp",
      "type": "adaptive_function_space_gaussian_process",
      "gaussian_process": {
        "type": "standard",
        "mean": {
          "type": "spherical",
          "center": [
            0,
            0,
            0
          ],
          "radius": 0.6
        },
        "covariance": {
          "type": "squared_exponential",
          "sigma": 0.08,
          "lengthScale": 0.25
        }
      },
      "max_bounces": 64,
      "sigma_a": 0,
      "sigma_s": 1,
      "density": 1,
      "correlation_context": "renewal+",
      "intersect_method": "gp_discrete",
      "normal_method": "conditioned_gaussian",
      "phase_function": {
        "type": "brdf",
        "bsdf": {
          "type": "lambert",
          "albedo": [
            0.25,
            0.55,
            0.8
          ]
        }
      },
      "adaptive": {
        "probability_tolerance": 0.001,
        "minimum_step": 0.005,
        "root_tolerance": 1e-05,
        "rank_tolerance": 1e-10,
        "max_samples": 512,
        "max_steps": 100000,
        "statistics": true
      }
    }
  ],
  "bsdfs": [
    {
      "name": "boundary",
      "type": "forward",
      "albedo": 1
    }
  ],
  "primitives": [
    {
      "name": "finite_process_bounds",
      "type": "cube",
      "bsdf": "boundary",
      "int_medium": "gp",
      "transform": {
        "scale": [
          2.4,
          2.4,
          2.4
        ]
      }
    },
    {
      "type": "infinite_sphere",
      "emission": [
        0.2,
        0.2,
        0.2
      ],
      "sample": true
    },
    {
      "type": "sphere",
      "name": "key",
      "transform": {
        "position": [
          1,
          -2,
          2
        ],
        "scale": 0.25
      },
      "emission": 30,
      "bsdf": {
        "type": "null"
      }
    }
  ],
  "camera": {
    "type": "pinhole",
    "resolution": [
      32,
      32
    ],
    "fov": 30,
    "transform": {
      "position": [
        2.4,
        -3.6,
        2.1
      ],
      "look_at": [
        0,
        0,
        0
      ],
      "up": [
        0,
        0,
        1
      ]
    },
    "tonemap": "filmic",
    "reconstruction_filter": "tent"
  },
  "integrator": {
    "type": "path_tracer",
    "max_bounces": 8,
    "min_bounces": 0,
    "enable_light_sampling": true,
    "enable_volume_light_sampling": true,
    "use_cuda_gpis": false,
    "wavefront_gpis": false,
    "independent_path_sampling": true
  },
  "renderer": {
    "spp": 8,
    "spp_step": 1,
    "adaptive_sampling": false,
    "output_file": "render.png",
    "hdr_output_file": "render.pfm",
    "overwrite_output_files": true,
    "stratified_sampler": false,
    "enable_resume_render": false
  }
}
