{
  "media": [
    {
      "name": "gp",
      "type": "adaptive_function_space_gaussian_process",
      "gaussian_process": {
        "id": 0,
        "type": "standard",
        "covariance_epsilon": 0,
        "pseudo_inverse": true,
        "mean": {
          "type": "procedural",
          "func": "knob",
          "transform": {
            "position": [
              0.0,
              0.8,
              0.0
            ],
            "scale": 1.0,
            "rotation": [
              0.0,
              0.0,
              0.0
            ]
          }
        },
        "covariance": {
          "type": "squared_exponential",
          "lengthScale": 0.2,
          "sigma": 0.02
        }
      },
      "max_bounces": 64,
      "sigma_a": 0,
      "sigma_s": 1,
      "density": 1,
      "correlation_context": "renewal+",
      "intersect_method": "gp_discrete",
      "normal_method": "conditioned_gaussian",
      "phase_function": {
        "type": "brdf",
        "bsdf": {
          "albedo": [
            0.15,
            0.8,
            0.5
          ],
          "type": "lambert"
        }
      },
      "adaptive": {
        "probability_tolerance": 0.001,
        "minimum_step": 0.0025,
        "root_tolerance": 1e-05,
        "rank_tolerance": 1e-10,
        "max_samples": 512,
        "max_steps": 100000,
        "statistics": true
      }
    }
  ],
  "bsdfs": [],
  "primitives": [
    {
      "name": "processBox",
      "transform": {
        "position": [
          0,
          1.001,
          0
        ],
        "scale": 3,
        "rotation": [
          0,
          0,
          0
        ]
      },
      "type": "cube",
      "bsdf": {
        "type": "forward",
        "albedo": 1
      },
      "int_medium": "gp"
    },
    {
      "name": "small_sphere_key",
      "type": "sphere",
      "emission": 2000.0,
      "bsdf": {
        "type": "null",
        "albedo": 1
      },
      "transform": {
        "position": [
          -3.0,
          3.0,
          4.0
        ],
        "scale": 0.06
      }
    }
  ],
  "camera": {
    "tonemap": "filmic",
    "resolution": [
      32,
      32
    ],
