{
  "media": [{
    "name": "first_hit_surface",
    "type": "first_hit_gpis",
    "gaussian_process": {
      "type": "standard",
      "mean": {"type": "spherical", "center": [0, 0, 0], "radius": 0.6},
      "covariance": {"type": "squared_exponential", "sigma": 0.08, "lengthScale": 0.25}
    },
    "material": {"type": "mirror", "albedo": [0.2, 0.5, 0.8]},
    "max_bounces": 1,
    "first_hit": {
      "probability_tolerance": 0.005,
      "distance_tolerance": 0.002,
      "max_nodes": 48,
      "qmc_samples": 256,
      "max_qmc_samples": 8192,
      "max_refinements": 256
    }
  }],
  "bsdfs": [{"name": "boundary", "type": "forward", "albedo": 1}],
  "primitives": [
    {"name": "finite_process_bounds", "type": "cube", "bsdf": "boundary",
     "int_medium": "first_hit_surface", "transform": {"scale": [2.4, 2.4, 2.4]}},
    {"type": "infinite_sphere", "emission": [1, 1, 1], "sample": true}
  ],
  "camera": {
    "type": "pinhole", "resolution": [128, 128], "fov": 30,
    "transform": {"position": [2.4, -3.6, 2.1], "look_at": [0, 0, 0], "up": [0, 0, 1]},
    "tonemap": "filmic", "reconstruction_filter": "tent"
  },
  "integrator": {
    "type": "path_tracer", "max_bounces": 2, "min_bounces": 0,
    "enable_light_sampling": true, "enable_volume_light_sampling": true,
    "use_cuda_gpis": false
  },
  "renderer": {
    "spp": 32, "spp_step": 8, "adaptive_sampling": false,
    "output_file": "first-hit-gpis.png", "hdr_output_file": "first-hit-gpis.exr",
    "overwrite_output_files": true
  }
}
