{
  "media": [{
    "name": "single_history_surface",
    "type": "single_history_gpis",
    "gaussian_process": {
      "type": "standard",
      "mean": {"type": "spherical", "center": [0, 0, 0], "radius": 0.6},
      "covariance": {"type": "squared_exponential", "sigma": 0.08, "lengthScale": 0.25}
    },
    "material": {"type": "mirror", "albedo": [0.2, 0.5, 0.8]},
    "max_bounces": 4,
    "single_history": {
      "selection_step_over_length": 0.5,
      "history_groups": 8,
      "shadow_roulette_threshold": 0.1,
      "normalized_bound_only": true,
      "far_bound_start_scale": 4,
      "tighten_expected_events": 8,
      "probability_method": "numeric",
      "profile": true
    }
  }],
  "bsdfs": [{"name": "boundary", "type": "forward", "albedo": 1}],
  "primitives": [
    {"name": "finite_process_bounds", "type": "cube", "bsdf": "boundary",
     "int_medium": "single_history_surface", "transform": {"scale": [2.4, 2.4, 2.4]}},
    {"type": "infinite_sphere", "emission": [1, 1, 1], "sample": true}
  ],
  "camera": {
    "type": "pinhole", "resolution": [16, 16], "fov": 30,
    "transform": {"position": [2.4, -3.6, 2.1], "look_at": [0, 0, 0], "up": [0, 0, 1]},
    "tonemap": "filmic", "reconstruction_filter": "tent"
  },
  "integrator": {
    "type": "path_tracer", "max_bounces": 6, "min_bounces": 0,
    "enable_light_sampling": true, "enable_volume_light_sampling": true,
    "use_cuda_gpis": false
  },
  "renderer": {
    "spp": 1, "spp_step": 1, "adaptive_sampling": false,
    "output_file": "single-history-gpis.png", "hdr_output_file": "single-history-gpis.exr",
    "overwrite_output_files": true
  }
}
