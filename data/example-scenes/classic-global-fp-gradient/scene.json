{
  "media": [{
    "name": "fp_gradient_surface",
    "type": "classic_global_fp_gradient",
    "gaussian_process": {
      "type": "standard",
      "mean": {"type": "spherical", "center": [0, 0, 0], "radius": 0.6},
      "covariance": {"type": "squared_exponential", "sigma": 0.08, "lengthScale": 0.25}
    },
    "material": {"type": "mirror", "albedo": [0.2, 0.5, 0.8]},
    "fp_gradient": {"enabled": true, "bridge_correction": true, "anchor_selection": "fixed5_snr"},
    "max_bounces": 8
  }],
  "bsdfs": [{"name": "boundary", "type": "forward", "albedo": 1}],
  "primitives": [
    {"name": "finite_process_bounds", "type": "cube", "bsdf": "boundary",
     "int_medium": "fp_gradient_surface", "transform": {"scale": [2.4, 2.4, 2.4]}},
    {"type": "infinite_sphere", "emission": [1, 1, 1], "sample": true}
  ],
  "camera": {
    "type": "pinhole", "resolution": [64, 64], "fov": 30,
    "transform": {"position": [2.4, -3.6, 2.1], "look_at": [0, 0, 0], "up": [0, 0, 1]},
    "tonemap": "filmic", "reconstruction_filter": "tent"
  },
  "integrator": {
    "type": "path_tracer", "max_bounces": 10, "min_bounces": 0,
    "enable_light_sampling": true, "enable_volume_light_sampling": true,
    "use_cuda_gpis": false
  },
  "renderer": {
    "spp": 8, "spp_step": 8, "adaptive_sampling": false,
    "output_file": "classic-global-fp-gradient.png", "hdr_output_file": "classic-global-fp-gradient.exr",
    "overwrite_output_files": true
  }
}
