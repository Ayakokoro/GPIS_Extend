          "albedo": 0.8
        }
      },
      "sigma_a": 0,
      "sigma_s": 1,
      "density": 1,
      "step_size": 0.0025,
      "min_step": 8,
      "seed": 17429,
      "impulse_density": 10,
      "single_realization": false,
      "correlation_context": "global",
      "intersect_method": "gp_discrete",
      "normal_method": "conditioned_gaussian",
